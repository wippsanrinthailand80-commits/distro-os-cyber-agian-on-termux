# PhantomSec OS — Linux Kernel Configuration
# Based on kernel 6.6.x — security-optimized minimal config
# Generate full config: cd linux-src && make KCONFIG_CONFIG=this_file olddefconfig

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_250=y

# ── Security hardening ────────────────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_YAMA=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_GCC_PLUGIN_RANDSTRUCT=y
CONFIG_GCC_PLUGIN_STACKLEAK=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_RETPOLINE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_LOCK_DOWN_KERNEL=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y

# ── Networking ────────────────────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_PACKET=y
CONFIG_AF_PACKET=y
CONFIG_UNIX=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_RAW_SOCKETS=y
CONFIG_TUN=y

# ── BPF (for eBPF-based tools) ────────────────────────────────────────────────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPFFILTER=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_UPROBE_EVENTS=y

# ── ptrace (for SyscallDNA) ───────────────────────────────────────────────────
CONFIG_PTRACE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ── inotify (for EntropyWarden) ───────────────────────────────────────────────
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y

# ── Filesystem ────────────────────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_ISO9660_FS=y
CONFIG_CRAMFS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y

# ── Block devices ─────────────────────────────────────────────────────────────
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_BLK_DEV_INITRD=y

# ── Cryptography ─────────────────────────────────────────────────────────────
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_POLY1305=y
CONFIG_CRYPTO_BLAKE2S=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_RANDOM32_SELFTEST=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=y

# ── Memory ───────────────────────────────────────────────────────────────────
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_NUMA=y

# ── Misc ─────────────────────────────────────────────────────────────────────
CONFIG_DEFAULT_HOSTNAME="phantomsec"
CONFIG_EXPERT=y
CONFIG_EMBEDDED=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
